## SETEX E2E — variables de entorno de ejemplo. Copia a .env y rellena.

# URL base donde correr los tests (default staging)
SETEX_E2E_BASE_URL=https://staging.setex-facturas.es

# Credenciales seed de staging (ver scripts/seed-staging.js)
SETEX_E2E_ADMIN_EMAIL=admin@staging.setex.local
SETEX_E2E_ADMIN_PASSWORD=Staging2026!

SETEX_E2E_USER_EMAIL=empresa1@staging.setex.local
SETEX_E2E_USER_PASSWORD=Staging2026!

# Ruta a la factura muestra usada en el test de upload
SETEX_E2E_SAMPLE_INVOICE=./fixtures/factura-muestra.jpg

# BasicAuth de Traefik (solo staging; dejar vacío para prod)
# Ver docker-compose.yml de staging: middleware setex-stg-auth activo.
SETEX_E2E_HTTP_BASIC_USER=setex
SETEX_E2E_HTTP_BASIC_PASSWORD=<pídele la pw a Julio>


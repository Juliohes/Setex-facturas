# ═══════════════════════════════════════════════════════════════
# SETEX Captura de Facturas — Variables de entorno
# ═══════════════════════════════════════════════════════════════
#
# Copia este archivo como .env y rellena los valores para el entorno.
# NUNCA commitees el archivo .env con valores reales.
#
# Los SECRETOS (contraseñas, API keys, JWT) NO van aquí.
# Se gestionan como Docker Secrets en /run/secrets/.
# Ver directorio: secrets/ (no versionado en git)
#
# El mismo docker-compose.yml sirve para prod y staging — las
# diferencias entre entornos se definen aquí.
# ═══════════════════════════════════════════════════════════════

# ── Proyecto Compose ─────────────────────────────────────────
# Prefijo de contenedores, redes y volúmenes. Cambiar por entorno:
#   setex-prod     para producción
#   setex-staging  para staging
COMPOSE_PROJECT_NAME=setex-prod

# ── Rutas base en el host ────────────────────────────────────
# Directorio raíz del entorno y sus subdirectorios de datos,
# logs y secretos. Deben existir y ser escribibles por el user
# que arranca docker compose.
SETEX_BASE_DIR=/opt/setex/prod
SETEX_DATA_DIR=/opt/setex/prod/data
SETEX_LOGS_DIR=/opt/setex/prod/logs
SETEX_SECRETS_DIR=/opt/setex/prod/secrets

# ── Dominio público ──────────────────────────────────────────
# Dominio que sirve el frontend. Traefik emite cert Let's Encrypt
# automáticamente para este Host. Ejemplos:
#   setex-facturas.es           (prod)
#   staging.setex-facturas.es   (staging)
SETEX_DOMAIN=setex-facturas.es

# ── Entorno de la aplicación ─────────────────────────────────
NODE_ENV=production
PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────
# Host resoluble dentro de la red interna del compose. Por
# defecto coincide con el service name 'postgres'. Cambiar solo
# si se usa una base externa.
POSTGRES_HOST=postgres

# ── SMTP (servidor de correo) ────────────────────────────────
# Usuario y contraseña SMTP van en Docker Secrets, no aquí.
# Ejemplos de host:
#   smtp.gmail.com              (prod, cuenta Google)
#   sandbox.smtp.mailtrap.io    (staging con Mailtrap Sandbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ── Redis ────────────────────────────────────────────────────
# La contraseña de Redis va en Docker Secrets (redis_password).
REDIS_URL=redis://redis:6379

# ── Rate limiting ────────────────────────────────────────────
# Máximo de uploads por ventana de 15 minutos por usuario.
UPLOAD_RATE_LIMIT=30

# ── Límites de recursos Docker ───────────────────────────────
# Ajustar según el entorno. Staging puede ir más bajo para
# convivir con prod en el mismo VPS.
CPU_LIMIT_DB=0.5
MEM_LIMIT_DB=512M
CPU_LIMIT_BACKEND=0.5
MEM_LIMIT_BACKEND=512M
CPU_LIMIT_REDIS=0.25
MEM_LIMIT_REDIS=192M
CPU_LIMIT_FRONTEND=0.25
MEM_LIMIT_FRONTEND=128M

# ── Traefik routing ──────────────────────────────────────────
# Nombre base para routers y middlewares. Debe ser único por
# entorno para que no colisionen cuando conviven en el mismo
# Traefik. Sugerido: 'setex' (prod), 'setex-stg' (staging).
SETEX_ROUTER=setex

# Middlewares adicionales aplicados al router HTTPS principal,
# separados por coma. Vacío en prod, 'setex-stg-auth' en staging
# para que Traefik exija BasicAuth antes de servir el frontend.
SETEX_HTTPS_MIDDLEWARES=

# Usuarios BasicAuth en formato htpasswd (user:hash).
# En docker-compose hay que escapar '$' como '$$'.
# Generar: htpasswd -nbB <user> <pass> | sed 's/\$/\$\$/g'
# En prod se deja un placeholder inocuo porque el middleware no
# está activo (SETEX_HTTPS_MIDDLEWARES vacío).
SETEX_BASICAUTH_USERS=noop:noop

# IP allowlist — CIDR(s) separados por coma. Solo limita si se añade
# `${SETEX_ROUTER}-ipallow` a SETEX_HTTPS_MIDDLEWARES. Ejemplo staging
# restrictivo:
#   SETEX_HTTPS_MIDDLEWARES=setex-stg-auth,setex-stg-ipallow
#   SETEX_ALLOWED_IPS=81.202.10.15/32,2.138.44.0/24
# Default 0.0.0.0/0 (abierto) para que el middleware sea inocuo si
# nadie lo activa.
SETEX_ALLOWED_IPS=0.0.0.0/0
